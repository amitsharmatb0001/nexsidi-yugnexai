        "description": "string",
        "due_date": "timestamp"
      },
      "responseBody": {
        "id": "uuid",
        "title": "string",
        "due_date": "timestamp",
        "is_completed": "boolean"
      }
    },
    {
      "method": "PUT",
      "path": "/api/v1/tasks/:id",
      "description": "Update an existing task's title, description, or due date.",
      "auth": true,
      "requestBody": {
        "title": "string",
        "description": "string",
        "due_date": "timestamp",
        "is_completed": "boolean"
      },
      "responseBody": {
        "id": "uuid",
        "title": "string",
        "due_date": "timestamp",
        "is_completed": "boolean"
      }
    },
    {
      "method": "DELETE",
      "path": "/api/v1/tasks/:id",
      "description": "Permanently delete a specific task.",
      "auth": true,
      "requestBody": null,
      "responseBody": {
        "success": "boolean"
      }
    }
  ],
